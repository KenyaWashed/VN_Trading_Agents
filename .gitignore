# Data snapshots and raw caches (never redistribute raw market data)
/data/
!/data/.gitkeep

# Experiment artifacts & logs (tracked locally per run, reproducible via configs)
/artifacts/
/logs/
/mlruns/
/wandb/

# Python / build / virtualenvs
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz

# Local autonomous task queue & scratch state
tasks*.txt
AUTONOMOUS_STATE*.md

# Ignore all Markdown documentation except the root README.md
*.md
!/README.md

# Ignore LaTeX / PDF / generated report files on GitHub (kept locally)
*.tex
*.bib
paper/main.pdf
paper/tables/
paper/figures/
paper/generated_provenance.json

# IDE settings
.vscode/
